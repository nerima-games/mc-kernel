    "ruleId": "no-effect-run-outside-entrypoints",
    "text": "Effect.runSync(Effect.result(Effect.try({ try: () => { if (!isRecord(value)) return false const keys = Object.keys(value) if (!keys.every((key) => key === 'item' || key === 'count' || key === 'components')) return false if (!Object.hasOwn(value, 'item') || !Object.hasOwn(value, 'count') || !Object.hasOwn(value, 'components')) return false const item = Reflect.get(value, 'item') const components = Reflect.get(value, 'components') const count = Reflect.get(value, 'count') return isItemType(item) && isItemComponents(components) && typeof count === 'number' && Number.isSafeInteger(count) && count >= 1 && count <= components.maxStackSize }, catch: () => failure('stack', 'Unable to inspect item stack', 'hostile-input', value), })))"
