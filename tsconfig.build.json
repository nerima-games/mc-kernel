{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "tests/**",
    "scripts/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
