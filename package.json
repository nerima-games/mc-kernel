{
  "name": "@nerima-games/mc-kernel",
  "version": "0.2.0",
  "type": "module",
  "description": "Shared vocabulary for the nerima-games Minecraft-clone rebuild: branded types, coordinates, block capability flags, frame contracts, and the clock Port.",
  "homepage": "https://github.com/nerima-games/mc-kernel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-kernel.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-kernel/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "kernel"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --noEmit --pretty false && tsc -p tsconfig.json --pretty false",
    "build": "tsc -p tsconfig.build.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts tests",
    "lint:fix": "oxlint --fix src scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench:block-registry": "pnpm build && node benchmarks/block-registry.mjs",
    "api:check": "tsx scripts/api-lock.ts",
    "api:update": "tsx scripts/api-lock.ts --write",
    "check:package": "pnpm build && tsx scripts/check-package.ts",
    "prepack": "pnpm build",
    "verify": "pnpm typecheck && pnpm lint && pnpm api:check && pnpm test && pnpm check:package"
  },
  "dependencies": {
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^3.2.7"
  }
}
