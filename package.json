  "scripts": {
    "typecheck:dependencies": "tsc -p tsconfig.dependency-check.json --pretty false",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false && node scripts/restore-public-entrypoints.mjs",
    "lint": "oxlint --deny-warnings src test && ast-grep scan && ast-grep test",
    "lint:fix": "oxlint --fix src test",
    "test": "vitest run",
    "check:conformance": "vitest run test/vanilla-26-3.test.ts",
    "generate:vanilla": "node --experimental-strip-types scripts/generate-vanilla-tables.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "pnpm build && node scripts/benchmark.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify"
  },
  "dependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
