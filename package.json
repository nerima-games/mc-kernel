    "typecheck:dependencies": "tsc -p tsconfig.dependency-check.json --pretty false",
    "typecheck": "pnpm typecheck:dependencies && tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "build": "tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src test && ast-grep scan",
    "lint:fix": "oxlint --fix src test",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "pnpm build",
    "test:coverage": "vitest run --coverage",
    "benchmark": "pnpm build && node scripts/benchmark.mjs",
    "typecheck:safety": "node scripts/check-type-safety.mjs",
    "scripts:check": "node --check scripts/benchmark.mjs && node --check scripts/check-type-safety.mjs && node --check scripts/verify-package.mjs && pnpm typecheck:safety",
    "verify": "pnpm scripts:check && pnpm typecheck && pnpm lint && pnpm test:coverage",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify"
  },
