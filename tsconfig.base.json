{
  // Shared compiler options for every tsconfig in this repository.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // mc-kernel is platform-agnostic: no DOM, no WebWorker, no Node globals.
    // Repos that need those add them in their own tsconfig.base.json.
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // A type-only import must say so. The emitted JavaScript then follows from
    // the import statement alone, with no whole-program analysis deciding which
    // specifiers survive — which is what a package shipping ESM to fifteen
    // consumers wants.
    "verbatimModuleSyntax": true,
    // Nothing that needs a runtime transform to have meaning: no enum, no
    // namespace, no parameter property. The domain is types and const data
    // already, so this pins the property rather than requesting a change.
    "erasableSyntaxOnly": true,
    // A side-effect import that resolves to nothing is an error, not a no-op.
    "noUncheckedSideEffectImports": true,
    // `isolatedDeclarations` is deliberately absent, and this is the record of
    // why so the question is not reopened from scratch. It would suit a package
    // freezing its API — every exported type written down rather than inferred,
    // so a changed return type shows up as a source diff instead of a quietly
    // different .d.ts. But it cannot express Effect's Tag idiom:
    // `class ClockPort extends Context.Tag('...')<ClockPort, ClockService>() {}`
    // extends a call expression, and a declaration emitted without looking at
    // other files cannot name that base (TS9021). Working around it would mean
    // declaring the Port some way other than the one Effect documents, which is
    // a worse trade than leaving the flag off.
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // The default remains check-only. `tsconfig.release.json` is the sole
    // emitting configuration, so source imports stay type-safe while the
    // published package exposes only generated JavaScript and declarations.
    "noEmit": true,

  }
}
